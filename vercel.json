{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"static demo: no install\"",
  "buildCommand": "node scripts/build_static_demo.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/demo/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
