# SAM3 Seismic Segmentation — Docker Environment Variables
# Copy this file to .env and edit as needed.

# Host port mapped to container port 8000
SAM3_PORT=8000

# ---- Less commonly changed ----
# Bind address inside the container (usually leave as-is)
# SAM3_HOST=0.0.0.0

# Uncomment to select a specific GPU (0-indexed)
# CUDA_VISIBLE_DEVICES=0
